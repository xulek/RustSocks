#%PAM-1.0
#
# RustSocks client-address authentication service.
#
# SECURITY DEFAULT: fail closed. Replace these rules with an explicit policy
# before setting client_method = "pam.address".
#
# Example with pam_access.so:
#   auth       required     pam_access.so
#   account    required     pam_access.so
#
# Then configure /etc/security/access.conf for the networks/hosts that may use
# the proxy. Do not replace the deny rules with pam_permit.so in production.

auth       required     pam_deny.so
account    required     pam_deny.so
